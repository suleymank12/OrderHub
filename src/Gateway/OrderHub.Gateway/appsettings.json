{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Yarp": "Information"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      { "Name": "File", "Args": { "path": "logs/gateway-.log", "rollingInterval": "Day" } }
    ]
  },
  "JwtSettings": {
    "Issuer": "OrderHub.OrderService",
    "Audience": "OrderHub.Clients"
  },
  "RateLimiting": {
    "PermitLimit": 100,
    "Window": "00:00:10"
  },
  "HealthChecksUI": {
    "//": "★ Merkezi sağlık panosu (§6.4). Poll edilecek 6 servisin /health/ready'si — compose servis adları (internal 8080). Route edilmeyen servisler (inventory/orderprocessing/notification, HTTP API'siz) de operasyonel görünürlük için burada. Saf-edge: yalnız HTTP poll (ProjectReference YOK).",
    "HealthChecks": [
      { "Name": "orderservice", "Uri": "http://orderservice:8080/health/ready" },
      { "Name": "paymentservice", "Uri": "http://paymentservice:8080/health/ready" },
      { "Name": "analyticsservice", "Uri": "http://analyticsservice:8080/health/ready" },
      { "Name": "inventoryservice", "Uri": "http://inventoryservice:8080/health/ready" },
      { "Name": "orderprocessingservice", "Uri": "http://orderprocessingservice:8080/health/ready" },
      { "Name": "notificationservice", "Uri": "http://notificationservice:8080/health/ready" }
    ],
    "EvaluationTimeInSeconds": 15,
    "MinimumSecondsBetweenFailureNotifications": 60
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "ReverseProxy": {
    "Routes": {
      "orders": {
        "ClusterId": "orderservice",
        "AuthorizationPolicy": "default",
        "Match": { "Path": "/api/orders/{**catch-all}" }
      },
      "payments": {
        "ClusterId": "paymentservice",
        "AuthorizationPolicy": "default",
        "Match": { "Path": "/api/payments/{**catch-all}" }
      },
      "analytics": {
        "ClusterId": "analyticsservice",
        "AuthorizationPolicy": "default",
        "Match": { "Path": "/api/analytics/{**catch-all}" }
      },
      "dev-token": {
        "ClusterId": "orderservice",
        "AuthorizationPolicy": "anonymous",
        "Match": { "Path": "/api/dev/token" }
      }
    },
    "Clusters": {
      "orderservice": {
        "Destinations": { "primary": { "Address": "http://orderservice:8080" } }
      },
      "paymentservice": {
        "Destinations": { "primary": { "Address": "http://paymentservice:8080" } }
      },
      "analyticsservice": {
        "Destinations": { "primary": { "Address": "http://analyticsservice:8080" } }
      }
    }
  }
}
