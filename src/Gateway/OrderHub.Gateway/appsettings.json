{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Yarp": "Information"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      { "Name": "File", "Args": { "path": "logs/gateway-.log", "rollingInterval": "Day" } }
    ]
  },
  "JwtSettings": {
    "Issuer": "OrderHub.OrderService",
    "Audience": "OrderHub.Clients"
  },
  "RateLimiting": {
    "PermitLimit": 100,
    "Window": "00:00:10"
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "ReverseProxy": {
    "Routes": {
      "orders": {
        "ClusterId": "orderservice",
        "AuthorizationPolicy": "default",
        "Match": { "Path": "/api/orders/{**catch-all}" }
      },
      "payments": {
        "ClusterId": "paymentservice",
        "AuthorizationPolicy": "default",
        "Match": { "Path": "/api/payments/{**catch-all}" }
      },
      "analytics": {
        "ClusterId": "analyticsservice",
        "AuthorizationPolicy": "default",
        "Match": { "Path": "/api/analytics/{**catch-all}" }
      },
      "dev-token": {
        "ClusterId": "orderservice",
        "AuthorizationPolicy": "anonymous",
        "Match": { "Path": "/api/dev/token" }
      }
    },
    "Clusters": {
      "orderservice": {
        "Destinations": { "primary": { "Address": "http://orderservice:8080" } }
      },
      "paymentservice": {
        "Destinations": { "primary": { "Address": "http://paymentservice:8080" } }
      },
      "analyticsservice": {
        "Destinations": { "primary": { "Address": "http://analyticsservice:8080" } }
      }
    }
  }
}
