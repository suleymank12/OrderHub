<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>OrderHub.OrderService.Infrastructure</AssemblyName>
    <RootNamespace>OrderHub.OrderService.Infrastructure</RootNamespace>
  </PropertyGroup>

  <!-- DbContext/Repository internal (§9); yalnızca integration test assembly'sine açılır. -->
  <ItemGroup>
    <InternalsVisibleTo Include="OrderHub.OrderService.IntegrationTests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OrderService.Application\OrderHub.OrderService.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- IBackgroundJobClient / IRecurringJobManager soyutlamaları: scheduling adapter'ı ve recurring
         registrar Application port'larını burada (Infrastructure) implement eder (DIP). Hangfire hosting
         (server/dashboard) Api'de kalır. -->
    <PackageReference Include="Hangfire.Core" />
    <!-- RecurringJobRegistrar IHostedService olarak sweep'i startup'ta kaydeder. -->
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
    <!-- Design: sadece migration üretimi için; downstream'e (Api) sızmasın. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
