<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <AssemblyName>OrderHub.OrderService.Api</AssemblyName>
    <RootNamespace>OrderHub.OrderService.Api</RootNamespace>
    <!-- Swagger XML için doc üret; TreatWarningsAsErrors ile CS1591 (missing doc) spam'ini tek yerde sustur. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\OrderService.Application\OrderHub.OrderService.Application.csproj" />
    <ProjectReference Include="..\OrderService.Infrastructure\OrderHub.OrderService.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="Swashbuckle.AspNetCore" />
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Serilog.Sinks.Seq" />
    <PackageReference Include="Serilog.Sinks.File" />
    <PackageReference Include="AspNetCore.HealthChecks.SqlServer" />
  </ItemGroup>

</Project>
