<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>OrderHub.OrderService.Application</AssemblyName>
    <RootNamespace>OrderHub.OrderService.Application</RootNamespace>
  </PropertyGroup>

  <!-- Handler/behavior'lar internal (§9 encapsulation); yalnızca unit test assembly'sine açılır.
       Prod davranışı değişmez, public API yüzeyi genişlemez. -->
  <ItemGroup>
    <InternalsVisibleTo Include="OrderHub.OrderService.UnitTests" />
    <!-- Background job sınıfları (CancelUnpaidOrderJob/SweepUnpaidOrdersJob) internal; Infrastructure'daki
         Hangfire adapter/registrar onları tip olarak schedule eder (Infra→App, DIP). Public yapmak yerine
         friend assembly → API yüzeyi dar kalır (§9). -->
    <InternalsVisibleTo Include="OrderHub.OrderService.Infrastructure" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OrderService.Domain\OrderHub.OrderService.Domain.csproj" />
  </ItemGroup>

  <!-- Versiyonlar kök Directory.Packages.props'ta (CPM). -->
  <ItemGroup>
    <PackageReference Include="MediatR" />
    <PackageReference Include="FluentValidation" />
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" />
    <PackageReference Include="Mapster" />
    <PackageReference Include="Mapster.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
  </ItemGroup>

</Project>
