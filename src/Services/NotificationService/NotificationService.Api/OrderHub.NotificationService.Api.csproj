<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <AssemblyName>OrderHub.NotificationService.Api</AssemblyName>
    <RootNamespace>OrderHub.NotificationService.Api</RootNamespace>
  </PropertyGroup>

  <!-- Internal Api tipleri yalnızca integration test assembly'sine açılır (§9). -->
  <ItemGroup>
    <InternalsVisibleTo Include="OrderHub.NotificationService.IntegrationTests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Clean Arch: Api → Application + Infrastructure (DbContext, consumer, migration). -->
    <ProjectReference Include="..\NotificationService.Application\OrderHub.NotificationService.Application.csproj" />
    <ProjectReference Include="..\NotificationService.Infrastructure\OrderHub.NotificationService.Infrastructure.csproj" />
    <ProjectReference Include="..\..\..\BuildingBlocks\OrderHub.Observability\OrderHub.Observability.csproj" />
  </ItemGroup>

  <!-- JWT/Swagger YOK: NotificationService 5f-2'de HTTP endpoint'siz (Kafka consumer + Hangfire). -->
  <ItemGroup>
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Serilog.Sinks.Seq" />
    <PackageReference Include="Serilog.Sinks.File" />
    <PackageReference Include="AspNetCore.HealthChecks.SqlServer" />
    <!-- Hangfire: server (IHostedService) + ASP.NET Core DI entegrasyonu. -->
    <PackageReference Include="Hangfire.AspNetCore" />
    <!-- SQL Server storage: HangFire şeması domain DB'sinde (ADR-0003 precedent). -->
    <PackageReference Include="Hangfire.SqlServer" />
  </ItemGroup>

</Project>
