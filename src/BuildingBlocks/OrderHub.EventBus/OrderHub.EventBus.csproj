<Project Sdk="Microsoft.NET.Sdk">

  <!-- Integration event soyutlaması + RabbitMQ taşıma wrapper'ı (ADR-0004).
       TFM / Nullable / ImplicitUsings / LangVersion → kök Directory.Build.props.
       AssemblyName = csproj adı = OrderHub.EventBus (zaten tam ad). -->

  <ItemGroup>
    <!-- MassTransit core (AddMassTransit, IPublishEndpoint) + RabbitMQ transport (UsingRabbitMq).
         RabbitMQ paketi MassTransit'i transitively getirir; ikisi de explicit → niyet açık. -->
    <PackageReference Include="MassTransit" />
    <PackageReference Include="MassTransit.RabbitMQ" />
    <!-- Kafka event-stream producer (ADR-0006 Karar 2): doğrudan Confluent.Kafka, idempotent producer. -->
    <PackageReference Include="Confluent.Kafka" />
    <!-- IServiceCollection extension (AddRabbitMqEventBus / AddKafkaRouting) + [FromKeyedServices] için DI paketi. -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <!-- Routing/Kafka publisher'ları internal → odaklı unit test projesine açılır (encapsulation korunur). -->
    <InternalsVisibleTo Include="OrderHub.EventBus.UnitTests" />
  </ItemGroup>

</Project>
