# OrderHub — local dev port mapping ŞABLONU (committed).
# Bu dosyayı .override.yml olarak kopyala (o gitignored, K3):
#   cp docker/docker-compose.override.yml.example docker/docker-compose.override.yml
#
# Ana docker-compose.yml'de bilinçli olarak published port YOKTUR (K3 — servisler
# yalnızca 'orderhub' bridge ağında konuşur). Host'tan erişim SADECE bu override ile
# açılır; böylece prod-benzeri ana compose dosyası dışa kapalı kalır.
# "host:container" — host portunu çakışmaya göre serbestçe değiştir.

services:
  sqlserver:
    ports:
      - "1433:1433" # SSMS / Azure Data Studio ile bağlan

  seq:
    ports:
      - "8081:80" # Seq UI → http://localhost:8081 (container içi 80)

  orderservice:
    ports:
      - "8080:8080" # Swagger → http://localhost:8080/swagger (container içi 8080)

  rabbitmq:
    ports:
      - "5672:5672"   # AMQP — host'tan broker erişimi (debug / 3d test repro)
      - "15672:15672" # Management UI → http://localhost:15672 (guest yerine .env user/pass)

  kafka:
    ports:
      - "9092:9094" # host → EXTERNAL listener (advertised localhost:9092); debug/test repro (Faz 4)

  kafka-ui:
    ports:
      - "8088:8080" # Kafka UI → http://localhost:8088 (topic/consumer-group/lag gözlemi)

  paymentservice:
    ports:
      - "8082:8080" # Swagger → http://localhost:8082/swagger (orderservice 8080 ile çakışmasın)

  analyticsservice:
    ports:
      - "8083:8080" # Swagger → http://localhost:8083/swagger (order 8080 / payment 8082 ile çakışmasın)

  inventoryservice:
    ports:
      - "8084:8080" # health-only → http://localhost:8084/health/ready (5b'de Swagger/HTTP API yok; 8080-8083 çakışmasın)

  orderprocessingservice:
    ports:
      - "8085:8080" # health-only → http://localhost:8085/health/ready (saga host, HTTP API yok; 8080-8084 çakışmasın)

  notificationservice:
    ports:
      - "8086:8080" # health-only → http://localhost:8086/health/ready (Kafka consumer, HTTP API yok; 8080-8085 çakışmasın)

  gateway:
    ports:
      - "8000:8080" # ★ TEK dışa açık giriş (edge). Dev: downstream 8080-8086 de expose (doğrudan Swagger/debug);
                    # prod: yalnız gateway expose, downstream'ler internal kalır (dokümante sınır — dev convenience).
