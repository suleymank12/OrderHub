# Bu dosya ŞABLONDUR ve commit'lenir. Gerçek değerleri `docker/.env`'e kopyala (o gitignored).
#   cp docker/.env.example docker/.env   → sonra değerleri değiştir.
# K3: hiçbir gerçek secret repo'da tutulmaz; aşağıdakiler PLACEHOLDER'dır.

# SQL Server SA şifresi. SQL Server politikası: min 8 karakter, en az 3 grup
# (büyük/küçük harf, rakam, özel karakter). Değiştir.
SQL_SA_PASSWORD=ChangeMe!Strong0Passw0rd

# JWT imzalama secret'ı. HMAC-SHA256 için ≥32 karakter zorunlu. Değiştir.
JWT_SECRET=change-me-to-strong-32-plus-char-secret-for-jwt-signing

# RabbitMQ kimlik bilgileri (Faz 3). compose'da RABBITMQ_DEFAULT_USER/PASS (broker) ve servislerin
# RabbitMq__Username/Password (order + payment) env'ine map'lenir → broker ve client AYNI kimlik.
# K3: gerçek parola repo'da tutulmaz; aşağıdakiler PLACEHOLDER'dır. Değiştir.
RABBITMQ_USER=orderhub
RABBITMQ_PASSWORD=ChangeMe!Strong0Rabbit

# Kafka (Faz 4): YENİ SECRET YOK. Dev broker PLAINTEXT (auth yok) → kimlik bilgisi gerekmez.
# OrderService (producer) ve AnalyticsService (consumer) Kafka__BootstrapServers=kafka:9092 ile bağlanır
# (compose env override; secret içermez). AnalyticsService read-API yukarıdaki JWT_SECRET'ı kullanır.

# InventoryService (Faz 5 5b): YENİ SECRET YOK. HTTP endpoint yok (command-driven) → JWT gerekmez; yalnız
# OrderHub_Inventory connection (yukarıdaki SQL_SA_PASSWORD'ü paylaşır). Saga/consumer (RabbitMQ) 5c-5d'de gelecek.
