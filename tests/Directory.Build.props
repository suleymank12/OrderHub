<Project>

  <!-- MSBuild yalnızca EN YAKIN Directory.Build.props'u otomatik alır; bu dosya kökü
       gölgelemesin diye kök Directory.Build.props'u explicit zincirliyoruz. -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- Test projelerine özel, bilinçli analyzer gevşetmeleri:
         CA1707: test metod isimleri davranışı anlatmak için underscore içerir (Method_Scenario_Expected).
         CA1822: stateless [Fact] metotları için "static yap" önerisi; test konvansiyonu instance metottur.
         CA1711: xUnit collection-definition sınıfı idiomatik olarak '...Collection' ile biter (false-positive). -->
    <NoWarn>$(NoWarn);CA1707;CA1822;CA1711</NoWarn>
  </PropertyGroup>

  <!-- Tüm test projelerinde ortak paketler (EK2). Projeye özel paketler csproj'lerde kalır. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="coverlet.collector">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <!-- Tüm test projelerinde global using (ImplicitUsings ile). Xunit + FluentAssertions
       her test projesinde kullanılıyor → ortak. (FA package ref'i projeye özel kalır, EK2.) -->
  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="FluentAssertions" />
  </ItemGroup>

</Project>
