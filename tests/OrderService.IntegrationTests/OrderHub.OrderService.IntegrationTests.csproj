  <PropertyGroup>
    <AssemblyName>OrderHub.OrderService.IntegrationTests</AssemblyName>
    <RootNamespace>OrderHub.OrderService.IntegrationTests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Services\OrderService\OrderService.Api\OrderHub.OrderService.Api.csproj" />
    <ProjectReference Include="..\..\src\Services\OrderService\OrderService.Infrastructure\OrderHub.OrderService.Infrastructure.csproj" />
  </ItemGroup>

