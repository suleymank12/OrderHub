<Project>

  <PropertyGroup>
    <!-- Hedef framework: stack §3 kilidi, tüm projeler net8.0 (LTS). -->
    <TargetFramework>net8.0</TargetFramework>

    <!-- Explicit dil sürümü: "latest" yerine sabit → reproducible, SDK upgrade'i sessizce davranış değiştirmez. -->
    <LangVersion>12.0</LangVersion>

    <!-- Nullable + ImplicitUsings: CLAUDE.md §9 zorunlu. -->
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- Warning = teknik borç. K5: "çalışıyor" yetmez → warning build'i kırar. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <!-- .editorconfig kuralları "öneri" değil, build gate'i. -->
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest-recommended</AnalysisLevel>

    <!-- XML doc üretimi: IDE0005 (gereksiz using) gate'inin build'de çalışması için gerekli;
         ayrıca Swagger + IntelliSense'e XML sağlar. CS1591 (her public üyeye doc zorunluluğu)
         bastırılır — doc disiplini dosya bazında tutulur, analyzer zoruyla değil. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>

    <!-- Reproducible restore + supply-chain: lock file zorunlu, CI lock dogrulamasi (locked mode). -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>

    <!-- InvariantGlobalization KASITLI OLARAK KAPALI (default false).
         Faz 1.1'de "container slimming" için true yapılmıştı; ANCAK Microsoft.Data.SqlClient
         (EF Core SQL Server provider) invariant mode'u DESTEKLEMEZ → bağlantı açarken
         NotSupportedException fırlatır. Tüm servisler SQL Server kullandığından bu Api'yi
         runtime'da (Faz 1.6 container'da) çökertirdi. Slimming kazancı zaten yoktu: tek
         executable Api SQL'e bağlanmak için ICU'ya muhtaç. Integration testlerde yakalandı. -->

    <Deterministic>true</Deterministic>
  </PropertyGroup>

</Project>
