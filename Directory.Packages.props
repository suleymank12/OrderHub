<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- Transitive paketleri de merkezi versiyona sabitler → diamond dependency sürprizlerini keser. -->
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup Label="CQRS / Validation / Mapping">
    <!-- MediatR 12.x son ÜCRETSIZ (Apache-2.0) hat; v13+ ticari lisans. Sabit pin → yanlışlıkla 13'e sıçramayız. -->
    <PackageVersion Include="MediatR" Version="12.4.1" />
    <!-- FluentValidation 11.x son ücretsiz hat; v12+ ticari. -->
    <PackageVersion Include="FluentValidation" Version="11.11.0" />
    <PackageVersion Include="FluentValidation.DependencyInjectionExtensions" Version="11.11.0" />
    <PackageVersion Include="Mapster" Version="7.4.0" />
    <PackageVersion Include="Mapster.DependencyInjection" Version="1.0.1" />
    <!-- ILogger ABSTRACTION'ı (sink değil). Application katmanı LoggingBehavior + handler'larda
         yapısal log basar; Serilog sink Api katmanında. MediatR/FluentValidation bunu transitively
         getirmiyor → açıkça pinliyoruz. -->
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.2" />
    <!-- IOptions<T> abstraction'ı: Application config option'larını (OrderTimeoutOptions) bağımlılık olarak
         alır; binding/validation Infrastructure'da. Abstraction-only paket (sink değil). -->
    <PackageVersion Include="Microsoft.Extensions.Options" Version="8.0.2" />
    <!-- DI extension method'ları (AddRabbitMqEventBus / AddOutbox) ve IServiceScopeFactory için
         abstraction-only paket. BuildingBlocks composition root'a hosting'i bağlamadan IServiceCollection
         genişletir (Microsoft.Extensions.Hosting değil → building block hafif kalır). -->
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.2" />
  </ItemGroup>

  <ItemGroup Label="EF Core (SQL Server)">
    <!-- Provider-agnostik EF Core (Relational): OrderHub.Outbox building block'u SaveChangesInterceptor
         (Core), IEntityTypeConfiguration + ToTable + index mapping (Relational) için bağlanır; SQL Server
         provider'a DEĞİL → outbox provider-bağımsız kalır, SQL Server bağlama servis Infrastructure'ında.
         Relational, Core'u transitively getirir. 8.0.11'de SqlServer ile aynı hatta pinli (diamond keser). -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="8.0.11" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="8.0.11" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.11" />
    <!-- Yalnız UNIT test: InboxConsumeFilter dedup mantığı (flat tablo, owned type yok → InMemory uygun;
         "no InMemory" kuralı domain-persistence fidelity'si içindir, burada geçerli değil). -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.InMemory" Version="8.0.11" />
    <!-- IHostedService / AddHostedService: recurring job registrar (sweep) startup'ta kayıt için. -->
    <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="8.0.1" />
    <!-- ConfigurationBinder.Get<T>(): Infrastructure composition root'ta RabbitMqOptions'ı config'ten bağlar
         (Abstractions Get<T> içermez). -->
    <PackageVersion Include="Microsoft.Extensions.Configuration.Binder" Version="8.0.2" />
    <!-- IConfiguration + GetConnectionString (Infrastructure DI); abstraction-only (provider Api'de). -->
    <PackageVersion Include="Microsoft.Extensions.Configuration.Abstractions" Version="8.0.0" />
    <!-- ConfigurationBuilder + AddInMemoryCollection: integration test BuildProvider'larında IConfiguration üretmek için.
         Api katmanı bunu AspNetCore aracılığıyla transitively getirir; test projeleri Api'ye bağımlı olmadığından
         doğrudan pin eklendi (yalnız test csproj'lerinde referans alınır). -->
    <PackageVersion Include="Microsoft.Extensions.Configuration" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup Label="Background Jobs (Hangfire)">
    <!-- 1.8.23: 1.8 hattının son stable'ı (.NET 8 uyumlu, SQL Server 2022 uyumlu). 1.8 = ücretsiz LGPL hat.
         Üçü de aynı sürüme pinli (diamond sürprizini keser). Hangfire.Core transitive ama CPM transitive
         pinning açık olduğundan explicit pinleniyor. Hangfire iş arg'larını internal Newtonsoft.Json ile
         serialize eder → bilinçli §3 istisnası (bkz. ADR-0003 §6). -->
    <PackageVersion Include="Hangfire.AspNetCore" Version="1.8.23" />
    <PackageVersion Include="Hangfire.SqlServer" Version="1.8.23" />
    <PackageVersion Include="Hangfire.Core" Version="1.8.23" />
  </ItemGroup>

  <ItemGroup Label="Messaging (MassTransit / RabbitMQ)">
    <!-- 8.4.0: 8.x hattı = ÜCRETSİZ (Apache-2.0); v9+ ticari lisans (ADR-0004). Sabit pin → v9'a sessiz sıçrama
         engellenir (MediatR/FluentValidation pin disiplini ile aynı). MassTransit.RabbitMQ transitive olarak
         RabbitMQ.Client getirir; default serializer System.Text.Json'dır (Newtonsoft YOK → §3, ADR-0004 Karar 3).
         ★ Faz 5 5d-4a: 8.5.9 → 8.4.0'a DÜŞÜLDÜ — MassTransit.EntityFrameworkCore 8.5.x'in net8.0 grubu
         EF Core 9.0.1'e bağlı (EF Core 8 LTS kilidini deler, §3). 8.4.0 net8.0 grubu EF Core 8.0.0 kullanır →
         EF Core 8.0.11 kilidi korunur. Saga API'leri (AddSagaStateMachine/EntityFrameworkRepository/
         ConcurrencyMode/UseInMemoryOutbox) 8.4.0'da değişmedi (minor downgrade, kod aynı). -->
    <PackageVersion Include="MassTransit" Version="8.4.0" />
    <PackageVersion Include="MassTransit.RabbitMQ" Version="8.4.0" />
    <!-- Faz 5 (ADR-0007 Karar 3): MassTransit saga state-machine'i EF Core saga repository ile persist eder
         (OrderHub_Sagas DB, database-per-service). MassTransit alt-paketleri lockstep → core ile AYNI sürüm (8.4.0)
         pinli (diamond sürpriz yok). MassTransit.Hangfire (saga-native timeout) BİLİNÇLİ eklenmedi (YAGNI):
         reservation expiry InventoryService Hangfire-job → StockReservationExpired event ile çözülür (ADR-0007
         Karar 2); saga-native scheduler gerçekten gerekirse eklenir. -->
    <PackageVersion Include="MassTransit.EntityFrameworkCore" Version="8.4.0" />
  </ItemGroup>

  <ItemGroup Label="Event Streaming (Kafka)">
    <!-- Confluent.Kafka 2.x (CLAUDE.md §3 stack kilidi): Kafka event-stream için doğrudan client (MassTransit
         rider değil, ADR-0006 Karar 2 — idempotent producer acks=all + enable.idempotence=true doğrudan kontrol).
         librdkafka native binary'sini taşır; .NET 8 / linux-x64 (compose) + win-x64 (local) destekli. -->
    <PackageVersion Include="Confluent.Kafka" Version="2.6.1" />
    <!-- Gerçek Kafka container'ı (4b integration): MsSql/RabbitMq ile aynı Testcontainers hattı. -->
    <PackageVersion Include="Testcontainers.Kafka" Version="4.0.0" />
  </ItemGroup>

  <ItemGroup Label="API / Auth / Logging / Health">
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.11" />
    <PackageVersion Include="Swashbuckle.AspNetCore" Version="6.9.0" />
    <PackageVersion Include="Serilog.AspNetCore" Version="8.0.3" />
    <PackageVersion Include="Serilog.Sinks.Seq" Version="8.0.0" />
    <PackageVersion Include="Serilog.Sinks.File" Version="6.0.0" />
    <PackageVersion Include="AspNetCore.HealthChecks.SqlServer" Version="8.0.2" />
  </ItemGroup>

  <ItemGroup Label="Gateway (YARP reverse proxy)">
    <!-- YARP 2.x: net8 uyumlu reverse proxy (CLAUDE.md §3 stack kilidi). Microsoft.Extensions.* 8.x'e bağlı →
         EF Core 8 / .NET 8 LTS kilidini DELMEZ (Faz 5 EF Core 9 dersi; locked-mode restore ile doğrulanır). -->
    <PackageVersion Include="Yarp.ReverseProxy" Version="2.2.0" />
  </ItemGroup>

  <ItemGroup Label="Test (ortak + projeye özel)">
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageVersion Include="xunit" Version="2.9.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="2.8.2" />
    <!-- Moq 4.20.0-4.20.1 SponsorLink ile git e-postası topluyordu (4.20.2'de kaldırıldı); 4.20.72 temiz. -->
    <PackageVersion Include="Moq" Version="4.20.72" />
    <!-- FluentAssertions 7.0.0: son Apache-2.0 (ücretsiz) sürüm. v8+ Xceed Community License → ticari kullanımda ücretli. -->
    <PackageVersion Include="FluentAssertions" Version="7.0.0" />
    <PackageVersion Include="AutoFixture" Version="4.18.1" />
    <PackageVersion Include="AutoFixture.AutoMoq" Version="4.18.1" />
    <PackageVersion Include="Testcontainers.MsSql" Version="4.0.0" />
    <!-- RabbitMQ smoke testi (3b-2): gerçek broker container'ı. MsSql ile aynı Testcontainers hattı (4.0.0). -->
    <PackageVersion Include="Testcontainers.RabbitMq" Version="4.0.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="8.0.11" />
    <PackageVersion Include="coverlet.collector" Version="6.0.2" />
    <!-- Gateway integration testlerinde downstream stub (YARP route/forward doğrulaması). net8 uyumlu. -->
    <PackageVersion Include="WireMock.Net" Version="1.6.7" />
  </ItemGroup>

</Project>
